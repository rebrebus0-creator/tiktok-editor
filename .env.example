# Бесплатные ключи: https://www.pexels.com/api/ и https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Нужен только для LLM-планировщика запросов (extras: llm)
ANTHROPIC_API_KEY=

# Куда складывать скачанные файлы
STOCK_MEDIA_CACHE_DIR=./media_cache

# YouTube-провайдер выключен по умолчанию (см. README, раздел про ToS)
STOCK_MEDIA_ENABLE_YOUTUBE=0
